# Documentation only: Spring Boot does not automatically load this file.
# Set these variables in IDEA Run Configuration > Environment variables.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aftersales_agent
DB_USERNAME=aftersales_app
DB_PASSWORD=replace-locally
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
AUTH_CACHE_NAMESPACE=aftersales:auth
AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Local embeddings; install Ollama and pull bge-m3 before enabling.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
KNOWLEDGE_MIN_SCORE=0.65
KNOWLEDGE_HYBRID_SEARCH=true
