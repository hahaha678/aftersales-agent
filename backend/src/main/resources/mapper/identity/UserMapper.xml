<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aftersales.identity.mapper.UserMapper">
    <sql id="columns">id, username, password_hash, display_name, role, enabled, created_at, updated_at</sql>
    <select id="findById" resultType="com.example.aftersales.identity.domain.po.UserPO">
        SELECT <include refid="columns"/> FROM app_user WHERE id = #{id}
    </select>
    <select id="findByUsername" resultType="com.example.aftersales.identity.domain.po.UserPO">
        SELECT <include refid="columns"/> FROM app_user WHERE username = #{username}
    </select>
</mapper>
